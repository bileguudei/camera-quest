# Copy this file to .env.modal.staging or .env.modal.production.
# Never commit the populated file.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=SERVER_ONLY
CALIBRATION_SIGNING_SECRET=AT_LEAST_32_RANDOM_CHARACTERS
ALLOWED_ORIGINS=http://localhost:3000,https://YOUR_DOMAIN
GEMINI_FALLBACK_ENABLED=false
SEMANTIC_QUESTS_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Optional. Leave blank when Sentry is not used.
SENTRY_DSN=
ENVIRONMENT=staging
