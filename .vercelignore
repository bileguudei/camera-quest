# Local dependency and build output
/node_modules
/.next
/.next-e2e
/out
/build
/coverage
/playwright-report
/test-results

# Local tooling and repository metadata
/.git
/.vercel
*.tsbuildinfo
.DS_Store

# Secrets stay in Vercel project environment variables
/.env*

# Python service caches are not part of the Next.js deployment
/vision-service/.venv
/vision-service/.mypy_cache
/vision-service/.pytest_cache
**/__pycache__/
**/*.py[cod]

# Generated by the prebuild script from @mediapipe/tasks-vision
/public/mediapipe/wasm
