# Browser-safe values only
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
NEXT_PUBLIC_VISION_URL=https://YOUR_MODAL_ENDPOINT
NEXT_PUBLIC_VISION_ENABLED=true
NEXT_PUBLIC_DEV_CONTROLS_ENABLED=false
# Optional. Leave blank when Sentry is not used.
NEXT_PUBLIC_SENTRY_DSN=

# Supabase Edge Function secret
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://YOUR_DOMAIN

# Modal secret: camera-quest-vision-secrets
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=SERVER_ONLY
CALIBRATION_SIGNING_SECRET=AT_LEAST_32_RANDOM_CHARACTERS
ALLOWED_ORIGINS=http://localhost:3000,https://YOUR_DOMAIN
GEMINI_FALLBACK_ENABLED=false
SEMANTIC_QUESTS_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Optional. Leave blank when Sentry is not used.
SENTRY_DSN=
ENVIRONMENT=staging
